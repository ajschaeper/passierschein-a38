SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OmgEP0aXY

# Alert thresholds
BEIHILFE_ALERT_WEEKS=8       # flag Beihilfe claims older than this
PKV_ALERT_WEEKS=4            # flag PKV claims older than this
CASHFLOW_ALERT_EUR=5000      # flag net exposure above this amount
